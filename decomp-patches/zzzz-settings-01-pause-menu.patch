+// Port: the settings hint under the save state one (settings menu,
+// src/settings_menu.cpp): the Y button, which the system font draws as the
+// controller in use labels it, and "SETTINGS". Pressing it while
+// paused opens the menu (move below).
+static void PauseSettingsHintDraw(TPauseMenu2* menu, JDrama::TGraphics* gfx)
+{
+	if (menu->mState == TPauseMenu2::MENU_SAVING || menu->mState == TPauseMenu2::MENU_CLOSED
+	    || SaveStateMenuIsOpen() || SettingsMenuIsOpen())
+		return;
+	const u8 alpha = menu->mMenuPane->getAlpha(); // fades with the menu
+	if (!alpha)
+		return;
+	JUTResFont* font = gpSystemFont;
+	const char* const kLabel = "\xA5 SETTINGS";
+	const f32 textSize = 18.0f;
+	const JDrama::TRect& viewport = gfx->getViewport();
+	const f32 right = viewport.getWidth() - 28.0f;
+	const f32 labelLine = 112.0f;
+	J2DOrthoGraph graph(viewport);
+	graph.setPort(); // the menu's screen left its own projection
+	graph.setup2D();
+	// a drop shadow, then the hint
+	for (int pass = 0; pass < 2; pass++) {
+		const f32 offset = pass == 0 ? 2.0f : 0.0f;
+		font->setGX();
+		font->setCharColor(pass == 0 ? JUtility::TColor(0, 0, 0, alpha / 2) : JUtility::TColor(255, 255, 255, alpha));
+		font->drawString_size_scale(right - PauseHintTextWidth(font, kLabel, textSize) + offset, labelLine + offset,
+		                            textSize, textSize, kLabel, strlen(kLabel), false);
+	}
+	gfx->setScissor(gfx->getScissor());
+}
