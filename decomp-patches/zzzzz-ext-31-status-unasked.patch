Reason: extensions (ext/, port_ext.h) are asked about the statuses TMario sets without changePlayerStatus, a spin jump started in the air (considerJumpRotate) and a jump's throw landing (jumpingThrow), as about every other (playerStatus: changed or refused; refused, he stays as he is), and hear of them (playerStatusChanged): the native mod API's SMS_EV_PLAYER_STATUS (API 1.6 beta 2)
--- a/src/Player/MarioJump.cpp
+++ b/src/Player/MarioJump.cpp
@@ -23,6 +23,23 @@
 	return sms_ext_r;
 }
 
+// port: a status the game sets without changePlayerStatus (a spin jump started
+// in the air, a jump's throw landing) is asked of extensions as that one's are,
+// and set the way the game sets it, with what they changed; 0 when refused,
+// and he stays as he is (port_ext.h)
+static BOOL portStatusUnasked(TMario* m, u32 status)
+{
+	const u32 from = m->mStatus;
+	u32 arg        = m->mStatusArg;
+	if (status != from && port_ext_player_status(m, &status, &arg, 0))
+		return FALSE;
+	m->mStatus    = status;
+	m->mStatusArg = arg;
+	if (status != from)
+		port_ext_player_status_changed(m, from, status, arg);
+	return TRUE;
+}
