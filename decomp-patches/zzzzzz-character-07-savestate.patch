+// After an exact save state load, once Mario plays: the character chosen now
+// in his place, if the state's is another, so loading a state never changes
+// who the player plays as. Without room in the stage's heap the state's
+// character stays until the next area brings the chosen one.
+static void ApplicationCharacterAfterLoad(TApplication* app)
+{
+	sCharacterAfterLoad = false;
+	const int chosen    = port_character_selected();
+	if (ApplicationCharacterKept(sCharacterModel) == chosen)
+		return;
+	if (!port_character_switching()) {
+		OSReport("[character] the state's character stays until the next area (single player only)\n");
+		return;
+	}
+	OSReport("[character] the state was saved as %s\n", *sCharacterModel ? sCharacterModel : "mario");
+	if (!ApplicationCharacterSwap(app, chosen))
+		OSReport("[character] the state's character stays until the next area\n");
+}
