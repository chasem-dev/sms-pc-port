+// Port: QUIT GAME (src/pause_quit.cpp), an item after the menu's own: after
+// EXIT AREA, or after SAVE where there is none (Delfino Plaza), in EXIT
+// AREA's place. It is a picture as theirs are, made from EXIT AREA's (tx_3's
+// PIC1 in pause_1.blo) with its own lettering. The menu's fields stay where
+// retail has them (Eclipse's code reads and sets them, mNumItems among them),
+// so it is kept here, as item mNumItems.
+static J2DPicture* sQuitItem;
+static JUTRect sQuitBounds;
+static s32 sMenuPaneY; // t_0's y in the layout, before the moves in load()
+
+static inline bool PauseIsQuitItem(const TPauseMenu2* menu, s32 i)
+{
+	return sQuitItem && i == menu->mNumItems;
+}
+
+static inline s32 PauseItemCount(const TPauseMenu2* menu)
+{
+	return menu->mNumItems + (sQuitItem ? 1 : 0);
+}
+
+static inline J2DPicture* PauseItem(TPauseMenu2* menu, s32 i)
+{
+	return PauseIsQuitItem(menu, i) ? sQuitItem : menu->mMenuItems[i];
+}
+
+static inline JUTRect& PauseItemBounds(TPauseMenu2* menu, s32 i)
+{
+	return PauseIsQuitItem(menu, i) ? sQuitBounds : menu->mOrigItemBounds[i];
+}
+
+static u32 PauseBE32(const u8* p)
+{
+	return (u32)p[0] << 24 | (u32)p[1] << 16 | (u32)p[2] << 8 | p[3];
+}
+
+// The menu gets the item when there is a picture for it.
+static void PauseQuitItemMake(TPauseMenu2* menu, J2DPicture* exitArea)
+{
+	sQuitItem             = nullptr;
+	s32 artWidth          = 0;
+	const ResTIMG* art    = PauseQuitArt(&artWidth);
+	const u8* blo         = (const u8*)JKRGetResource("/game_6/scrn/pause_1.blo");
+	if (!art || !exitArea || !exitArea->getTexture(0) || !blo || memcmp(blo, "SCRNblo1", 8) != 0)
+		return;
+	// tx_3's PIC1 (the layout is big-endian, as J2DScreen reads it)
+	const u32 size = PauseBE32(blo + 8);
+	for (u32 at = 0x20; at + 16 <= size;) {
+		const u32 n = PauseBE32(blo + at + 4);
+		if (n < 8 || at + n > size)
+			return;
+		if (!memcmp(blo + at, "PIC1", 4) && !memcmp(blo + at + 12, "tx_3", 4)) {
+			JSUMemoryInputStream stream(blo + at, n);
+			J2DPicture* item = new J2DPicture(menu->mMenuPane, &stream, true);
+			item->hide();
+			if (!item->getTexture(0))
+				return;
+			item->changeTexture(art, 0);
+			item->setUserInfo('tx_4');
+			// as wide as its lettering, at EXIT AREA's scale; placed in loadAfter()
+			const JUTRect& bounds = exitArea->getBounds();
+			const s32 w           = artWidth * bounds.getWidth() / exitArea->getTexture(0)->getWidth();
+			item->setBounds(JUTRect(0, 0, w, bounds.getHeight()));
+			// it turns about its own middle (the layout's base position was
+			// worked out for EXIT AREA's size)
+			item->setBasePosition(item->mBasePosition);
+			sQuitItem = item;
+			return;
+		}
+		at += n;
+	}
+}
+
+// The items lean 12 degrees, their centres on a slant down and to the right.
+// QUIT GAME goes on under the others: in EXIT AREA's place without it, else
+// a fourth row, the rows a little closer (36 apart, not 40 and 39) to keep
+// it clear of the stage name under them; and where the menu comes down 30 for
+// a stage with no episode name (load(), and Eclipse's own), only 15.
+static void PauseQuitItemLayout(TPauseMenu2* menu)
+{
+	if (!sQuitItem)
+		return;
+	const JUTRect& first = menu->mMenuItems[0]->getBounds();
+	const JUTRect& third = menu->mMenuItems[2]->getBounds();
+	const f32 x0 = (first.x1 + first.x2) * 0.5f, y0 = (first.y1 + first.y2) * 0.5f;
+	const f32 slant = ((third.x1 + third.x2) * 0.5f - x0) / ((third.y1 + third.y2) * 0.5f - y0);
+	const bool closer = menu->mNumItems == 3;
+	const f32 pitch   = closer ? 36.0f : ((third.y1 + third.y2) * 0.5f - y0) / 2;
+	if (closer) {
+		const s32 down = menu->mMenuPane->getBounds().y1 - sMenuPaneY;
+		if (down > 15)
+			menu->mMenuPane->add(0, 15 - down);
+	}
+	for (s32 i = 1; i < PauseItemCount(menu); i++) {
+		if (!closer && !PauseIsQuitItem(menu, i))
+			continue; // the game's own rows stay where they are
+		J2DPicture* item = PauseItem(menu, i);
+		const JUTRect& r = item->getBounds();
+		const s32 w = r.getWidth(), h = r.getHeight();
+		const s32 x = (s32)(x0 + slant * pitch * i - w * 0.5f + 0.5f);
+		const s32 y = (s32)(y0 + pitch * i - h * 0.5f + 0.5f);
+		item->setBounds(JUTRect(x, y, x + w, y + h));
+	}
+}
 #endif
 
