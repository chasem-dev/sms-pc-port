+// A state loaded by position only puts its file's progress (its flags) into
+// the game, which then saves it over the file being played. That is the
+// state's own file when the state says which it is: the game goes back to
+// that file, whichever was being played. A state from before states said
+// (or saved at the title) is taken as the file being played's, as ever, but
+// at the title no file is being played (only the last one's number is left),
+// so the game then saves over no file until the file select reads one.
+static void ApplicationStateTakeFile(TApplication* app)
+{
+	sStateFileUnknown = false;
+	const int file    = sStateLoad.saveFile - 1;
+	if (file >= 0 && file < 3) {
+		if (app->mSaveFile != file)
+			OSReport("[savestate] this state is file %c's: playing file %c\n", 'A' + file, 'A' + file);
+		app->mSaveFile = (s8)file;
+		return;
+	}
+	if (ApplicationStateFileOf(app) == 0) {
+		OSReport("[savestate] this state doesn't say which file it is from: no file is saved over\n");
+		sStateFileUnknown = true;
+		TFlagManager::getInstance()->setLastSaveTime(kStateNoFileTime);
+	}
+}
