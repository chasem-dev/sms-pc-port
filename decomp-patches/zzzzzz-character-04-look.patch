+#include <M3DUtil/MActor.hpp>
+#include <MarioUtil/ScreenUtil.hpp>
+#include <Strategic/ObjModel.hpp>
+
+// Port: a character's look (patch zzzzzz-character-04). A character whose
+// archive has a look/ folder with a default.bmd on Mario's skeleton is drawn
+// as that model in the body's place, posed by the body's joints each frame, as
+// the game draws Shadow Mario (TEMario::init, TEnemyMario::perform): fog on
+// its materials, the screen's picture as H_kagemario_dummy (the see-through
+// look), the folder's first .btk playing. The body, hands and cap are still
+// posed, for everything that reads them, but not drawn. Made with the player's
+// model, in the heap in force then (the stage's), so a new stage or a swap
+// makes it again.
+static MActor* sPortLook;
+static TMario* sPortLookOwner;
+static bool sPortLookScreen; // the screen's picture is in it
+
+void PortCharacterLookInit(TMario* mario)
+{
+	sPortLook       = nullptr;
+	sPortLookOwner  = nullptr;
+	sPortLookScreen = false;
+	if (!mario || !mario->mModel || !JKRFileLoader::getGlbResource("/mario/look/default.bmd"))
+		return;
+	TMActorKeeper* keeper     = new TMActorKeeper(nullptr, 1);
+	keeper->mModelLoaderFlags = 0x11300000;
+	MActor* look              = keeper->createMActorFromDefaultBmd("/mario/look", 0);
+	if (!look)
+		return;
+	J3DModel* model = look->getModel();
+	if (model->getModelData()->getJointNum() != mario->mModel->getModel()->getModelData()->getJointNum()) {
+		OSReport("[character] look/default.bmd has %d joints, not the body's %d: left out\n",
+		         (int)model->getModelData()->getJointNum(),
+		         (int)mario->mModel->getModel()->getModelData()->getJointNum());
+		return;
+	}
+	for (u16 i = 0; i < model->getModelData()->getMaterialNum(); i++)
+		SMS_InitPacket_Fog(model, i);
+	look->setBtkFromIndex(0);
+	sPortLook      = look;
+	sPortLookOwner = mario;
+	OSReport("[character] drawn as its look model\n");
+}
+
+void PortCharacterLookCalc(TMario* mario)
+{
+	if (!sPortLook || mario != sPortLookOwner)
+		return;
+	J3DModel* look = sPortLook->getModel();
+	// the screen texture is made with the stage's scene, after Mario
+	if (!sPortLookScreen && gpScreenTexture) {
+		gpScreenTexture->replace(look->getModelData(), "H_kagemario_dummy");
+		sPortLookScreen = true;
+	}
+	sPortLook->calcAnm();
+	J3DModel* body = mario->mModel->getModel();
+	for (u16 i = 0; i < body->getModelData()->getJointNum(); ++i)
+		MTXCopy(body->getAnmMtx(i), look->getAnmMtx(i));
+	look->calcWeightEnvelopeMtx();
+}
+
+bool PortCharacterLookView(TMario* mario)
+{
+	if (!sPortLook || mario != sPortLookOwner)
+		return false;
+	sPortLook->viewCalc();
+	return true;
+}
+
+bool PortCharacterLookEntry(TMario* mario)
+{
+	if (!sPortLook || mario != sPortLookOwner)
+		return false;
+	SMS_ResetDamageFogEffect(sPortLook->getModel()->getModelData());
+	sPortLook->entry();
 	return true;
 }
 #endif
