+// Port: a character pack's model may have fewer joints than Mario's (his caps
+// have 2 and 3, and TMarioCap hangs its effect on joint 1). Reading past the
+// joint table hands back whatever follows it, and setting a callback there
+// crashes. The effect stays, for the code that reaches it by index
+// (mMtxEffectTbl[1] in MarioDraw.cpp), on a joint no model draws.
+static J3DJoint* TMultiMtxEffectJoint(J3DModel* model, u16 id)
+{
+	static J3DJoint noJoint;
+	J3DModelData* data = model->getModelData();
+	return id < data->getJointNum() ? data->getJointNodePointer(id) : &noJoint;
+}
