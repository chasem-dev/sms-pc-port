Reason: Audio: host scheduling can defer JAudio port commands across game frames. Clearing mHead before re-enqueueing a pending intrusive-list node inserts it twice and loses the following commands; keep queue membership until getPortCmd consumes it, and merge pending parameter flags so tempo/pitch ramp endpoints survive deferred processing. Retail scheduling and code remain unchanged.
--- a/libs/JSystem/src/JAudio/JAInterface/JAIGFrameSequence.cpp
+++ b/libs/JSystem/src/JAudio/JAInterface/JAIGFrameSequence.cpp
@@ -604,8 +604,10 @@
 					    &unk0->mSeqTrackInfo[i], j, 1,
 					    unk0->mSeqTrackInfo[i].mTrackUpdate[j]);
 
+#ifndef TARGET_PC
 					unk0->mSeqTrackInfo[i].mPlayerParams[j].mCmd.mHead
 					    = nullptr;
+#endif
 					unk0->mSeqTrackInfo[i]
 					    .mPlayerParams[j]
 					    .mCmd.addPortCmdOnce();
--- a/libs/JSystem/src/JAudio/JAInterface/JAIGFrameSe.cpp
+++ b/libs/JSystem/src/JAudio/JAInterface/JAIGFrameSe.cpp
@@ -609,10 +609,12 @@
 		    &unk0->mSeqTrackInfo[mSeSequence->mTrack], sound->mTrack, 1,
 		    unk0->mSeqTrackInfo[mSeSequence->mTrack]
 		        .mTrackUpdate[sound->mTrack]);
+#ifndef TARGET_PC
 		unk0->mSeqTrackInfo[mSeSequence->mTrack]
 		    .mPlayerParams[sound->mTrack]
 		    .mCmd.mHead
 		    = nullptr;
+#endif
 		unk0->mSeqTrackInfo[mSeSequence->mTrack]
 		    .mPlayerParams[sound->mTrack]
 		    .mCmd.addPortCmdOnce();
--- a/libs/JSystem/src/JAudio/JAInterface/JAISystemInterface.cpp
+++ b/libs/JSystem/src/JAudio/JAInterface/JAISystemInterface.cpp
@@ -68,6 +68,14 @@
 void JAISystemInterface::setSeqPortargsU32(JAISeqUpdateData* sud, u32 track_no,
                                            u8 arg_no, u32 value)
 {
+#ifdef TARGET_PC
+	// Host scheduling can leave a command pending across game frames.
+	// Keep every dirty parameter until the audio callback consumes it.
+	if (arg_no == 1) {
+		sud->mPlayerParams[track_no].mArgs.mFlags |= value;
+		return;
+	}
+#endif
 	sud->mPlayerParams[track_no].mArgsAsU32[arg_no] = value;
 }
 
