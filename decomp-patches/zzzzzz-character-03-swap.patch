+// Mario's model, hands, caps and animations made again in place from the
+// archive on the "mario" volume (patch zzzzzz-character-03, MarioDraw.cpp).
+bool PortCharacterSwapModel(TMario* mario);
+
+// What a character's models and tables take beyond its archive, with room to
+// spare (Mario's own come to about 0.6 MB).
+static const s32 kCharacterModelRoom = 0x180000;
+
+// CHARACTER_NEXT in a stage: the character's archive (Mario's own for him) on
+// the "mario" volume and Mario's model, animations and voice made again from
+// it in place, in the stage's heap, without loading the area. False, with the
+// model as it was, when the heap has no room for them.
+static bool ApplicationCharacterSwap(TApplication* app, int index)
+{
+	TMario* mario = gpMarioOriginal;
+	if (!mario || !app->mHeap)
+		return false;
+	JKRHeap* prev     = JKRGetCurrentHeap();
+	const char* path  = port_character_path(index);
+	const s32 before  = app->mHeap->getFreeSize();
+	app->mHeap->becomeCurrentHeap();
+	void* arc = path ? ApplicationCharacterRead(path) : arcBufMario;
+	bool ok   = arc && app->mHeap->getFreeSize() >= kCharacterModelRoom;
+	if (ok) {
+		ApplicationCharacterRemount(arc);
+		sCharacterArc = path ? arc : nullptr;
+		ok            = PortCharacterSwapModel(mario);
+		ApplicationCharacterVoice(index);
+	}
+	prev->becomeCurrentHeap();
+	OSReport("[character] %s %s in place (%d KB of the stage's heap, %d KB left)\n", port_character_name(index),
+	         ok ? "swapped" : "not swapped", (int)((before - app->mHeap->getFreeSize()) >> 10),
+	         (int)(app->mHeap->getFreeSize() >> 10));
+	return ok;
+}
