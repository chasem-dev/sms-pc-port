+
+// The swap room, made at the first swap, or null when the stage's heap can't
+// spare it (the swap is then made in the stage's heap, as before).
+static JKRExpHeap* ApplicationCharacterSwapHeap(TApplication* app)
+{
+	if (sCharacterSwapHeap)
+		return sCharacterSwapHeap;
+	const s32 free = app->mHeap->getFreeSize() - kCharacterStageRoom;
+	const s32 size = free < kCharacterSwapRoom ? free : kCharacterSwapRoom;
+	if (size < kCharacterModelRoom * 2)
+		return nullptr;
+	sCharacterSwapHeap = JKRExpHeap::create(size, app->mHeap, false);
+	if (sCharacterSwapHeap)
+		OSReport("[character] %d KB of the stage's heap kept for switching characters\n", (int)(size >> 10));
+	return sCharacterSwapHeap;
+}
+
+static bool ApplicationCharacterSwapsOld()
+{
+	for (int i = 0; i < kCharacterSwapsOld; i++)
+		if (sCharacterSwapOld[i])
+			return true;
+	return false;
+}
+
+// Whether `p` is in memory the swap of `group` holds.
+static bool ApplicationCharacterSwapHolds(u8 group, const void* p)
+{
+	for (JKRExpHeap::CMemBlock* b = sCharacterSwapHeap->getHeadUsedList(); b; b = b->getNextBlock())
+		if (b->getGroupId() == group && p >= b->getContent() && p < (u8*)b->getContent() + b->getSize())
+			return true;
+	return false;
+}
+
+// A swap let go. What the stage keeps a list of goes from the list first: the
+// conductor's SDL model data, which an MActor drawn as an SDL model makes (a
+// character's look model, TMActorKeeper), drawn from that list every frame.
+static void ApplicationCharacterSwapFree(u8 group)
+{
+	if (gpConductor) {
+		JGadget::TList<SDLModelData*>& list = gpConductor->unk70;
+		for (JGadget::TList<SDLModelData*>::iterator it = list.begin(); it != list.end();)
+			if (ApplicationCharacterSwapHolds(group, *it))
+				it = list.erase(it);
+			else
+				++it;
+	}
+	sCharacterSwapHeap->freeGroup(group);
+}
+
+// Once a frame: the old swaps past their time let go. True when one was.
+static bool ApplicationCharacterSwapTick()
+{
+	bool freed = false;
+	for (int i = 0; sCharacterSwapHeap && i < kCharacterSwapsOld; i++) {
+		if (!sCharacterSwapOld[i] || --sCharacterSwapOldLeft[i] > 0)
+			continue;
+		ApplicationCharacterSwapFree(sCharacterSwapOld[i]);
+		sCharacterSwapOld[i] = 0;
+		freed                = true;
+	}
+	return freed;
+}
+
+// The swap worn until now, to be let go; with no place left in the list, it
+// stays until the stage ends, as every swap did before.
+static void ApplicationCharacterSwapRetire(u8 group)
+{
+	for (int i = 0; group && i < kCharacterSwapsOld; i++)
+		if (!sCharacterSwapOld[i]) {
+			sCharacterSwapOld[i]     = group;
+			sCharacterSwapOldLeft[i] = kCharacterSwapGrace;
+			return;
+		}
+}
+
+// A group no swap waiting to be let go, or worn, has (1..0xFE; 0xFF is the
+// heap's own, and 0 none).
+static u8 ApplicationCharacterSwapNewGroup()
+{
+	u8 group = sCharacterSwapGroup;
+	for (int tries = 0; tries < 0xFE; tries++) {
+		group     = group % 0xFE + 1;
+		bool used = group == sCharacterSwapGroup;
+		for (int i = 0; i < kCharacterSwapsOld; i++)
+			used = used || sCharacterSwapOld[i] == group;
+		if (!used)
+			return group;
+	}
+	return 0;
+}
