+// The stage has ended: its heap, the swap room with it, is emptied.
+static void ApplicationCharacterSwapForget()
+{
+	sCharacterSwapHeap    = nullptr;
+	sCharacterSwapGroup   = 0;
+	sCharacterSwapWaiting = false;
+	memset(sCharacterSwapOld, 0, sizeof sCharacterSwapOld);
