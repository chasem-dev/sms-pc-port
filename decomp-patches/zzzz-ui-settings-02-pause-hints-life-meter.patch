+#include <GC2D/BoundPane.hpp>
+
+// Where the hints go: the save state hint's buttons and label, and the
+// settings hint under them, right-aligned at `right`. `edge` is the corner's
+// right, which they go with to the screen edge with widescreen_hud = edges.
+struct PauseHintPlace {
+	f32 right, edge;
+	f32 buttonsLine, labelLine, settingsLine;
+};
+
+// At the top right corner, clear of the lives counter at the top centre. The
+// life meter comes down in that corner when Mario is hurt or under water (the
+// HUD's l_ba, its back, in the group l_0 that slides in and out; the radar
+// makes room for it too, patch zzzz-radar-01), and the game is paused where it
+// is. While it is there the hints go beside it, to its left, and a little
+// lower, so the label is under the lives counter and the settings hint over
+// the PAUSE lettering (in 4:3 units, the tightest; wider frames with
+// widescreen_hud = edges have more room, as the meter and the hints go to the
+// edge and the lives counter and lettering stay at the middle).
+static PauseHintPlace PauseHintPlaceNow(const JDrama::TRect& viewport)
+{
+	PauseHintPlace place;
+	place.edge         = viewport.getWidth() - 28.0f;
+	place.right        = place.edge;
+	place.buttonsLine  = 50.0f;
+	place.labelLine    = 74.0f;
+	place.settingsLine = 112.0f;
+	const TGCConsole2* console = gpMarDirector ? gpMarDirector->mConsole : nullptr;
+	if (!console || !console->unk1C4 || !console->unk174)
+		return place;
+	const J2DPane* group = console->unk1C4->getPane();
+	const J2DPane* back  = console->unk174->getPane();
+	if (!group || !back || !group->isVisible() || !back->isVisible())
+		return place;
+	const JUTRect& b = back->getGlobalBounds();
+	// its rays reach past its back: its round width, as a part of the back's
+	const f32 kRays = 1.25f, kGap = 8.0f;
+	const f32 left  = (b.x1 + b.x2) * 0.5f - (b.x2 - b.x1) * 0.5f * kRays;
+	// in the hints' way: in their corner (not where it first comes in, at the middle)
+	if (b.x2 <= b.x1 || b.y2 <= b.y1 || b.x2 < place.edge - 200.0f || b.y1 > place.settingsLine)
+		return place;
+	if (left - kGap < place.right)
+		place.right = left - kGap;
+	place.buttonsLine  = 88.0f;
+	place.labelLine    = 112.0f;
+	place.settingsLine = 136.0f;
+	return place;
+}
