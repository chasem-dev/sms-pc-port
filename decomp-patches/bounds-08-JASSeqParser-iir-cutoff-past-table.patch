+#ifdef TARGET_PC
+	// bounds-08: the IIR cutoff command reads CUTOFF_TO_IIR_TABLE with a u8,
+	// and a sound effect's under-water filter ramp ends on row 128, one past
+	// the table. The console reads the next .data, s_key_table, as big-endian
+	// s16 pairs; a host reads whatever its own layout puts there.
+	void portCutoffToIIR(u8 row, s16* out)
+	{
+		if (row < 128) {
+			for (int i = 0; i < 4; ++i)
+				out[i] = CUTOFF_TO_IIR_TABLE[row][i];
+		} else if (row < 160) {
+			for (int i = 0; i < 2; ++i) {
+				u32 bits;
+				memcpy(&bits, &s_key_table[(row - 128) * 2 + i], sizeof bits);
+				out[i * 2]     = (s16)(bits >> 16);
+				out[i * 2 + 1] = (s16)(bits & 0xFFFF);
+			}
+		} else {
+			// Past s_key_table the console reads the envelope tables and
+			// their pointers; no sequence is known to get here. Pass the
+			// sound through (row 127), rather than host memory.
+			for (int i = 0; i < 4; ++i)
+				out[i] = CUTOFF_TO_IIR_TABLE[127][i];
+		}
+	}
+#endif
+
 } // namespace Player
 
 } // namespace JASystem
