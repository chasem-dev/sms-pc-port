Reason: MinGW's _tolower assumes an uppercase input; resource volume paths are already lowercase, so it corrupts names such as subtitle.
--- a/src/JSystem/JKernel/JKRFileLoader.cpp
+++ b/src/JSystem/JKernel/JKRFileLoader.cpp
@@ -181,7 +181,7 @@ const char* JKRFileLoader::fetchVolumeName(char* buffer, long bufferSize,
 		while (*path != 0 && *path != '/') {
 			if (1 < bufferSize) {
-				*buffer = _tolower(*path);
+				*buffer = tolower((unsigned char)*path);
 				buffer++;
 				bufferSize--;
 			}
