+// Each player's own (patch zzzzzz-coop-12): split-screen co-op's player 2
+// (ext/coop) is a second TMario, made while port_coop_in_p2 is set, who may
+// be another character than player 1 and has a look and a FLUDD place of
+// their own.
+struct PortCharacterOwn {
+	TMario* owner;
+	MActor* look;
+	bool lookScreen; // the screen's picture is in it
+	f32 fluddScale;
+	f32 fluddOffset[3];
+	f32 fluddTilt;
+};
+static PortCharacterOwn sPortOwn[2];
+extern "C" int port_coop_in_p2; // platform/pad: player 2's globals are in force
 
+// The player's own, or null for a TMario that is no player (Shadow Mario).
+static PortCharacterOwn* PortCharacterOwnOf(TMario* mario)
+{
+	for (int i = 0; i < 2; i++)
+		if (mario && sPortOwn[i].owner == mario)
+			return &sPortOwn[i];
+	return nullptr;
+}
