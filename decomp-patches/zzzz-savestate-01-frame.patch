+// patch zzzz-savestate-02: closes the pause menu as Continue does.
+void PauseMenuCloseForStateLoad();
+
+// Port: save states (port_savestate.h), saved and loaded here, at the top of
+// the frame loop. Nothing of a frame is under way then, and this function's
+// callers hold only their loop state, so an exact load can replace the game's
+// memory wholesale and the loop carries on in the state's moment. A state
+// this build cannot load exactly loads its portable part instead: its flags,
+// a warp to its area (as ApplicationWarpFrame does), then Mario put back.
+enum {
+	STATE_LOAD_IDLE,
+	STATE_LOAD_UNPAUSE, // the pause menu closing first
+	STATE_LOAD_ARRIVE,  // on the way to the state's area
+};
+static PortSaveStatePortable sStateLoad;
+static u8 sStateLoadPhase;
+static u16 sStateLoadFrames;
+
+static void ApplicationStateCollect(TApplication* app, PortSaveStatePortable* p)
+{
+	memset(p, 0, sizeof *p);
+	p->area    = app->mCurrArea.getStage();
+	p->episode = app->mCurrArea.getScenario();
+	if (TMario* m = gpMarioOriginal) {
+		p->pos[0]       = m->mPosition.x;
+		p->pos[1]       = m->mPosition.y;
+		p->pos[2]       = m->mPosition.z;
+		p->vel[0]       = m->mVel.x;
+		p->vel[1]       = m->mVel.y;
+		p->vel[2]       = m->mVel.z;
+		p->forwardVel   = m->mForwardVel;
+		p->faceAngle[0] = m->mFaceAngle.x;
+		p->faceAngle[1] = m->mFaceAngle.y;
+		p->faceAngle[2] = m->mFaceAngle.z;
+		p->status       = m->mStatus;
+		p->statusArg    = m->mStatusArg;
+		p->health       = m->mHealth;
+		p->hasFludd     = m->checkFlag(MARIO_FLAG_HAS_FLUDD);
+		p->onYoshi      = m->onYoshi() != 0;
+		if (TWaterGun* gun = m->mWaterGun) {
+			p->water        = gun->mCurrentWater;
+			p->nozzle       = gun->mCurrentNozzle;
+			p->secondNozzle = gun->mSecondNozzle;
+		}
+	}
+	if (gpCamera) {
+		p->cameraPos[0] = gpCamera->unk124.x;
+		p->cameraPos[1] = gpCamera->unk124.y;
+		p->cameraPos[2] = gpCamera->unk124.z;
+		p->cameraAt[0]  = gpCamera->unk148.x;
+		p->cameraAt[1]  = gpCamera->unk148.y;
+		p->cameraAt[2]  = gpCamera->unk148.z;
+	}
+	TFlagManager* flags = TFlagManager::getInstance();
+	for (int i = 0; i < PORT_SAVESTATE_CARD_BOOLS; i++)
+		p->cardBools[i] = (u8)flags->getFlag(0x10000 + i);
+	for (int i = 0; i < PORT_SAVESTATE_CARD_INTS; i++)
+		p->cardInts[i] = flags->getFlag(0x20000 + i);
+	for (int i = 0; i < PORT_SAVESTATE_GAME_BOOLS; i++)
+		p->gameBools[i] = (u8)flags->getFlag(0x30000 + i);
+	for (int i = 0; i < PORT_SAVESTATE_GAME_INTS; i++)
+		p->gameInts[i] = flags->getFlag(0x40000 + i);
+	// the names the pause menu shows: the episode is the one the episode
+	// flag names, as there (TPauseMenu2::load)
+	const u8 world = ApplicationWarpWorld(p->area);
+	if (!ApplicationWarpMessage(p->stageName, sizeof p->stageName,
+	                            JKRFileLoader::getGlbResource("/common/2d/stagename.bmg"), world))
+		snprintf(p->stageName, sizeof p->stageName, "Area %d", (int)p->area);
+	ApplicationWarpMessage(p->episodeName, sizeof p->episodeName,
+	                       JKRFileLoader::getGlbResource("/common/2d/scenarioname.bmg"),
+	                       ApplicationWarpNameId(p->area, flags->getFlag(0x40003), world));
+}
+
+static void ApplicationStateApplyFlags(const PortSaveStatePortable& p)
+{
+	TFlagManager* flags = TFlagManager::getInstance();
+	for (int i = 0; i < PORT_SAVESTATE_CARD_BOOLS; i++)
+		flags->setFlag(0x10000 + i, p.cardBools[i]);
+	for (int i = 0; i < PORT_SAVESTATE_CARD_INTS; i++)
+		flags->setFlag(0x20000 + i, p.cardInts[i]);
+	for (int i = 0; i < PORT_SAVESTATE_GAME_BOOLS; i++)
+		flags->setFlag(0x30000 + i, p.gameBools[i]);
+	for (int i = 0; i < PORT_SAVESTATE_GAME_INTS; i++)
+		flags->setFlag(0x40000 + i, p.gameInts[i]);
+}
+
+// Mario where the state had him, facing the same way (warpRequest also moves
+// the camera with him), with his health and FLUDD's nozzle and water.
+static void ApplicationStateFinish()
+{
+	sStateLoadPhase = STATE_LOAD_IDLE;
+	// a stage change resets the coins: the state's flags once more
+	ApplicationStateApplyFlags(sStateLoad);
+	if (TMario* m = gpMarioOriginal) {
+		JGeometry::TVec3<f32> pos(sStateLoad.pos[0], sStateLoad.pos[1], sStateLoad.pos[2]);
+		m->warpRequest(pos, sStateLoad.faceAngle[1] * (360.0f / 65536.0f));
+		m->mHealth = sStateLoad.health;
+		TWaterGun* gun = m->mWaterGun;
+		if (gun && sStateLoad.hasFludd) {
+			if (gun->mCurrentNozzle != sStateLoad.nozzle)
+				gun->changeNozzle((TWaterGun::TNozzleType)sStateLoad.nozzle, true);
+			gun->mSecondNozzle = sStateLoad.secondNozzle;
+			gun->mCurrentWater = sStateLoad.water;
+		}
+	}
+	port_savestate_notify("State loaded (position only)");
+}
+
+static void ApplicationStateStartWarp(TApplication* app, TMarDirector* dir)
+{
+	sStateLoadPhase  = STATE_LOAD_ARRIVE;
+	sStateLoadFrames = 0;
+	ApplicationStateApplyFlags(sStateLoad);
+	if (app->mCurrArea.getStage() == sStateLoad.area && app->mCurrArea.getScenario() == sStateLoad.episode) {
+		ApplicationStateFinish();
+		return;
+	}
+	OSReport("[savestate] warping to area %d episode %d\n", (int)sStateLoad.area, (int)sStateLoad.episode);
+	TFlagManager::getInstance()->setFlag(0x40003, sStateLoad.episode);
+	dir->setNextStage((u16)(((sStateLoad.area + 1) << 8) | sStateLoad.episode), nullptr);
+}
+
+static void ApplicationSaveStateFrame(TApplication* app)
+{
+	TMarDirector* dir
+	    = app->mAppState == TApplication::APP_STATE_GAMEPLAY ? gpMarDirector : nullptr;
+	const bool playing = dir && gpMarioOriginal && dir->mState == TMarDirector::STATE_UNK4
+	                     && !dir->checkUnk4CFlag(TMarDirector::DIRECTOR_FLAG_STAGE_TRANSITION_PENDING);
+	const bool paused = dir && dir->mState == TMarDirector::STATE_PAUSE_MENU;
+	port_savestate_set_ready((playing || paused) && sStateLoadPhase == STATE_LOAD_IDLE);
+
+	if (sStateLoadPhase != STATE_LOAD_IDLE) {
+		// about 20 seconds at 60 frames a second, in case the warp never happens
+		if (++sStateLoadFrames > 1200) {
+			sStateLoadPhase = STATE_LOAD_IDLE;
+			port_savestate_notify("Could not load the state");
+		} else if (playing && sStateLoadPhase == STATE_LOAD_UNPAUSE) {
+			ApplicationStateStartWarp(app, dir);
+		} else if (playing && app->mCurrArea.getStage() == sStateLoad.area
+		           && app->mCurrArea.getScenario() == sStateLoad.episode) {
+			ApplicationStateFinish();
+		}
+		return;
+	}
+
+	char path[PORT_SAVESTATE_PATH_LEN];
+	switch (port_savestate_take(path, sizeof path)) {
+	case PORT_SAVESTATE_SAVE:
+		if (playing) {
+			PortSaveStatePortable state;
+			ApplicationStateCollect(app, &state);
+			port_savestate_save(&state);
+		} else if (paused) {
+			// the pause menu's hint: SAVE_STATE there opens the state menu
+			port_savestate_open_menu();
+		} else {
+			port_savestate_notify("Save states work in a level, once it has loaded");
+		}
+		break;
+	case PORT_SAVESTATE_LOAD: {
+		if (!playing && !paused)
+			break;
+		int hasPortable = 0;
+		// an exact load is done once this returns: the game is at the state's moment
+		if (port_savestate_load_exact(path, &sStateLoad, &hasPortable)) {
+			port_savestate_notify("State loaded");
+			break;
+		}
+		if (!hasPortable)
+			break;
+		if (paused) {
+			sStateLoadPhase  = STATE_LOAD_UNPAUSE;
+			sStateLoadFrames = 0;
+			PauseMenuCloseForStateLoad();
+		} else {
+			ApplicationStateStartWarp(app, dir);
+		}
+	} break;
+	default:
+		break;
+	}
+}
+#endif
