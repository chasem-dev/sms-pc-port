+			C_MTXLookAt(unk1EC, &sms_ext_eye, &mUp, &sms_ext_at);
+#else
 			C_MTXPerspective(unk16C, mFovy, mAspect, mNear, mFar);
 			C_MTXLookAt(unk1EC, &unk124, &mUp, &unk148);
+#endif
 		}
 
