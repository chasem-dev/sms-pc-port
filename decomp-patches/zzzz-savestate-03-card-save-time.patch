+
+// The game remembers when its file was last saved (TFlagManager's save time)
+// and saves only over a file the card says was saved then, so a card swapped
+// for another is not saved over (TCardSave, ext/autosave). A state keeps the
+// time of its own moment: one from before the file's latest save, or from
+// another run, would then never save again ("unable to save", and an auto
+// save that falls back to that), and progress made after it is lost when the
+// game is reset. So once a state has loaded, the game takes the time the card
+// has for its file, as if it had just read the file, and saves over it as
+// ever. The card is read between frames, as the prompt reads it, when no save
+// is under way.
+static TCardBookmarkInfo sStateCardMarks[3];
+static bool sStateCardReading;
 
+static void ApplicationStateCardStart()
+{
+	if (!gpCardManager || gpCardManager->mIsMounted || gpCardManager->getLastStatus() == CARD_RESULT_BUSY)
+		return;
+	gpCardManager->getBookmarkInfos(sStateCardMarks);
+	sStateCardReading = true;
+}
+
+static void ApplicationStateCardFrame(TApplication* app)
+{
+	if (!sStateCardReading || gpCardManager->getLastStatus() == CARD_RESULT_BUSY)
+		return;
+	sStateCardReading = false;
+	const int slot    = app->mSaveFile;
+	if (gpCardManager->getLastStatus() == CARD_RESULT_READY && slot >= 0 && slot < 3) {
+		// a damaged file, or one never saved, the prompt asks about as ever
+		const TCardBookmarkInfo& mark = sStateCardMarks[slot];
+		if (mark.unk0 != 1 && mark.unk18 != 0 && TFlagManager::getInstance()->getLastSaveTime() != (s64)mark.unk8) {
+			OSReport("[savestate] file %c was saved after this state: its next save goes over that one\n", 'A' + slot);
+			TFlagManager::getInstance()->setLastSaveTime((s64)mark.unk8);
+		}
+	}
+	gpCardManager->unmount();
+}
