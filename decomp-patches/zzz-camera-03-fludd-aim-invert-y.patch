Reason: port: Invert camera Y (SMS_CAMERA_INVERT_Y, platform/pad) also flips FLUDD's up and down aim while Mario sprays in place with R held all the way down, which reads the control stick rather than the C-stick
--- a/src/Player/WaterGun.cpp
+++ b/src/Player/WaterGun.cpp
@@ -276,6 +276,13 @@
 	return mario;
 }
 
+#ifdef TARGET_PC
+// SMS_CAMERA_INVERT_Y (platform/pad/pad.cpp) flips the C-stick, which only
+// turns the camera; aiming FLUDD in place (R held all the way down) reads the
+// control stick, so the setting flips that stick's up and down here too.
+extern "C" int port_camera_invert_y;
+#endif
+
 void TNozzleBase::calcGunAngle(const TMarioControllerWork& work)
 {
 	// volatile u32 unused1[17];
@@ -288,8 +295,15 @@
 	s16 angle;
 	if (NozzleMario(this)->mStatus == MARIO_STATUS_SQUAT) {
 			angle = unk36E;
+#ifdef TARGET_PC
+		f32 stickY = NozzleMario(this)->mGamePad->mCompSPos[0 * 2 + 1];
+		if (port_camera_invert_y)
+			stickY = -stickY;
+		angle += (s16)(stickY * mEmitParams.mRButtonMult.get());
+#else
 		angle += (s16)(NozzleMario(this)->mGamePad->mCompSPos[0 * 2 + 1]
 		               * mEmitParams.mRButtonMult.get());
+#endif
 	} else {
 		angle = -mEmitParams.mLAngleBase.get();
 	}
